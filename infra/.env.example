# LLM Council — Environment Configuration Template
# Copy this file to .env and adjust the values for your setup:
#   cp .env.example .env

# ==============================================================================
# 1. Cloud Models (OpenRouter) - Optional if using local models
# ==============================================================================
OPENROUTER_API_KEY=

# ==============================================================================
# 2. Local OpenAI-compatible Models (e.g. vLLM / Ollama / LM Studio)
# ==============================================================================
QWEN_BASE_URL=http://host.docker.internal:8002/v1
QWEN_MODEL_ID=/models/qwen3.6-27b
QWEN_API_KEY=not-needed

# ==============================================================================
# 3. Local Agent Shims (Claude Code & Antigravity headless proxies)
# ==============================================================================
CLAUDE_SHIM_BASE_URL=http://host.docker.internal:8600/v1
CLAUDE_SHIM_SECRET=not-needed

ANTIGRAVITY_SHIM_BASE_URL=http://host.docker.internal:8601/v1
ANTIGRAVITY_SHIM_SECRET=not-needed

# ==============================================================================
# 4. Host Mount Paths (Context Ingestion & Skill Prompts)
# ==============================================================================
SKILLS_DIR=./skills
WORKSPACE_DIR=../
