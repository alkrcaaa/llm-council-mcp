# LLM Council — Environment Configuration Template
# Copy this file to .env and set your own values.
# NEVER commit your actual .env file to version control.

# OpenRouter API Key (Required for cloud models like Nemotron, Inkling, Laguna, GPT, etc.)
# Get a free key at https://openrouter.ai (supports $0 :free models)
OPENROUTER_API_KEY=

# Local vLLM / Qwen Endpoint (Optional: only if running local inference)
QWEN_BASE_URL=http://host.docker.internal:8002/v1
QWEN_MODEL_ID=/models/qwen3.6-27b
QWEN_API_KEY=not-needed

# Local Agent Shims (Optional: for host-side Claude Code & Antigravity proxies)
# Each shim runs a CLI on your account and refuses to start without its secret.
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CLAUDE_SHIM_BASE_URL=http://host.docker.internal:8600/v1
CLAUDE_SHIM_SECRET=
ANTIGRAVITY_SHIM_BASE_URL=http://host.docker.internal:8601/v1
ANTIGRAVITY_SHIM_SECRET=

# Mount Paths for Skills and Workspace (adjust for your machine)
SKILLS_DIR=~/.gemini/config/skills
WORKSPACE_DIR=..

# Web UI Basic Authentication (Optional: defaults to admin/admin)
AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Required when AUTH_ENABLED is not false; generate the same way as the shim secrets.
JWT_SECRET=
