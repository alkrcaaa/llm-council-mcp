# LLM Council — Environment Configuration Template
# ./setup.sh creates .env from this file and fills in the secrets for you.
# Manual route: cp .env.example .env, then fill in the values below.
# NEVER commit your actual .env file to version control.

# ==============================================================================
# 1. Cloud models (OpenRouter)
# ==============================================================================
# Get a key at https://openrouter.ai/keys (models ending in :free cost $0)
OPENROUTER_API_KEY=

# ==============================================================================
# 2. Web UI login
# ==============================================================================
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Required when AUTH_ENABLED=true.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# ==============================================================================
# 3. Network exposure
# ==============================================================================
# 127.0.0.1 = this machine only. Set both to 0.0.0.0 to open the UI from other
# devices on your LAN (keep AUTH_ENABLED=true if you do).
BACKEND_BIND_HOST=127.0.0.1
FRONTEND_BIND_HOST=127.0.0.1

# ==============================================================================
# 4. Mount paths (relative paths resolve from the infra/ directory)
# ==============================================================================
# Folder of SKILL.md-style prompt files models can be decorated with (model@skill)
SKILLS_DIR=../skills
# Folder the council may read for local workspace context (read-only mount)
WORKSPACE_DIR=..

# ==============================================================================
# 5. Optional: local models
# ==============================================================================
# Any OpenAI-compatible server on the host (vLLM, Ollama, LM Studio).
# Other providers (Ollama, Groq, Gemini, ...) can also be added from the UI:
# Configure Models -> Model Studio & Providers.
QWEN_BASE_URL=http://host.docker.internal:8002/v1
QWEN_MODEL_ID=/models/qwen3.6-27b
QWEN_API_KEY=not-needed

# Host-side Claude Code & Antigravity CLI shims (infra/local-models/).
# Only needed if you run those shims; each refuses to start without its secret.
CLAUDE_SHIM_BASE_URL=http://host.docker.internal:8600/v1
CLAUDE_SHIM_SECRET=
ANTIGRAVITY_SHIM_BASE_URL=http://host.docker.internal:8601/v1
ANTIGRAVITY_SHIM_SECRET=
